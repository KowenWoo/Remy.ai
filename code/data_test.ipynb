   "source": [
    "\n",
    "\n",
    "def extract_ingredients_openai(ingredient_list, api_key):\n",
    "    \"\"\"\n",
    "    Extract core ingredients using OpenAI's API\n",
    "    \"\"\"\n",
    "    import openai\n",
    "    \n",
    "    openai.api_key = api_key\n",
    "    \n",
    "    # Convert list to string if needed\n",
    "    if isinstance(ingredient_list, list):\n",
    "        ingredients_text = \"\\n\".join([f\"- {item}\" for item in ingredient_list])\n",
    "    else:\n",
    "        ingredients_text = str(ingredient_list)\n",
    "    \n",
    "    prompt = f\"\"\"\n",
    "    Extract just the core ingredient names from this recipe ingredient list. \n",
    "    Remove all quantities, measurements, adjectives, cooking instructions, and descriptive words.\n",
    "    Return only the essential ingredient names, one per line.\n",
    "    \n",
    "    Example:\n",
    "    Input: \"2 cups unsalted butter, melted\"\n",
    "    Output: \"butter\"\n",
    "    \n",
    "    Input: \"1 large red onion, finely diced\"  \n",
    "    Output: \"onion\"\n",
    "    \n",
    "    Ingredient list:\n",
    "    {ingredients_text}\n",
    "    \n",
    "    Core ingredients (one per line):\n",
    "    \"\"\"\n",
    "    \n",
    "    try:\n",
    "        response = openai.ChatCompletion.create(\n",
    "            model=\"gpt-3.5-turbo\",  # or \"gpt-4\"\n",
    "            messages=[\n",
    "                {\"role\": \"system\", \"content\": \"You are a helpful assistant that extracts core ingredient names from recipe ingredients.\"},\n",
    "                {\"role\": \"user\", \"content\": prompt}\n",
    "            ],\n",
    "            temperature=0.1,\n",
    "            max_tokens=500\n",
    "        )\n",
    "        \n",
    "        result = response.choices[0].message.content.strip()\n",
    "        return [line.strip() for line in result.split('\\n') if line.strip()]\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"OpenAI API error: {e}\")\n",
    "        return ingredient_list"
   ]
  },
